<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSessionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phiên điểm danh"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMeetingInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Buổi học"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSessionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Trạng thái: Chưa mở"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSessionDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Thời lượng: 15 phút"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/progressSession"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSessionResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp" />


        <!-- MODULE 7: Khu vực hiển thị Dynamic QR -->
        <LinearLayout
            android:id="@+id/layoutQrContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#F3F5F8"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="MÃ QR ĐIỂM DANH"
                android:textColor="#202937"
                android:textSize="18sp"
                android:textStyle="bold" />


            <FrameLayout
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="#FFFFFF">

                <ImageView
                    android:id="@+id/ivAttendanceQr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Mã QR điểm danh"
                    android:scaleType="fitCenter"
                    android:visibility="invisible" />

                <ProgressBar
                    android:id="@+id/progressQr"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />

            </FrameLayout>


            <TextView
                android:id="@+id/tvQrStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Đang chờ cấp mã QR..."
                android:textColor="#586474"
                android:textSize="14sp" />

        </LinearLayout>


        <Button
            android:id="@+id/btnStartSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Bắt đầu điểm danh" />

        <!-- GPS: Lecturer Location -->
        <TextView
            android:id="@+id/tvGpsInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Vị trí GPS: Chưa lấy"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnCloseSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Đóng phiên điểm danh"
            android:enabled="false" />

        <Button
            android:id="@+id/btnRefreshSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Làm mới trạng thái" />

        <TextView
            android:id="@+id/tvSessionCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="--:--"
            android:textSize="28sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
